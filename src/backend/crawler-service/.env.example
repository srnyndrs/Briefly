# Feed Crawler Service — environment variables
# Copy this file to .env and fill in your local values.

# Application
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
FEED_EXCHANGE=feed.content

# Crawler behaviour
CRAWL_INTERVAL_SECONDS=300
FETCH_TIMEOUT_SECONDS=30
MAX_RETRIES=5
BASE_CRAWL_INTERVAL_SECONDS=300
