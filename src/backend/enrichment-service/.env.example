# Application
APP_HOST=0.0.0.0
APP_PORT=8005
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RESULT_EXCHANGE=enrichment.events

# Optional key for explicit Gemini evaluation only
GEMINI_API_KEY=

# Ollama runtime (choose and explicitly pull a model before starting)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
