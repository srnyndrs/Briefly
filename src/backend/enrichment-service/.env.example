# Application
APP_HOST=0.0.0.0
APP_PORT=8005
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
POST_CONSUMER_ENABLED=false
RESULT_EXCHANGE=enrichment.events
RESULT_QUEUE=enrichment.results.v1

# API KEYS
GEMINI_API_KEY=

# Local Ollama server for manual evaluation
OLLAMA_BASE_URL=http://localhost:11434
