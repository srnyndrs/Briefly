# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefly

# RabbitMQ read-model projector
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ACCOUNT_EXCHANGE=account.events
CONTENT_EXCHANGE=content.parsed
QUERY_QUEUE=public-api.query.v1
QUERY_CONSUMER_ENABLED=true

# Sentry
SENTRY_DSN=

# JWT validation (must match account-service)
JWT_SECRET=local-dev-secret-change-me
JWT_ISSUER=briefly-account-service
JWT_AUDIENCE=briefly-public-api

# Owning services and request timeouts
ACCOUNT_SERVICE_URL=http://localhost:8003
INGESTION_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:8002
REQUEST_TIMEOUT_SECONDS=10
SOURCE_DISCOVERY_TIMEOUT_SECONDS=15
