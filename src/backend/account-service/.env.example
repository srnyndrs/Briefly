# Account Service — environment variables
# Copy this file to .env and fill in your local values.

# Application
APP_HOST=0.0.0.0
APP_PORT=8003
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ACCOUNT_EXCHANGE=account.events

# Sentry DSN
SENTRY_DSN=

# JWT settings
JWT_SECRET=local-dev-secret-change-me
JWT_ISSUER=briefly-account-service
JWT_AUDIENCE=briefly-public-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

ADMIN_USER_IDS_CSV=

# Password reset
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@briefly.local
