# Application
APP_HOST=0.0.0.0
APP_PORT=8002
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
FEED_EXCHANGE=feed.content
FEED_QUEUE=feed.raw_fetched.v1.parser
PARSED_EXCHANGE=content.parsed
FAILED_EXCHANGE=content.failed
FEED_DLQ=feed.raw_fetched.v1.parser.dlq

# Processing timeouts (seconds)
BLOCKED_TIMEOUT_SECONDS=5
ARTICLE_REQUEST_TIMEOUT_SECONDS=5

# Sentry DSN (optional)
SENTRY_DSN=

# Admin API token (optional)
ADMIN_TOKEN=
