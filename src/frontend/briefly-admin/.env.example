# API base URL
REACT_APP_API_BASE_URL=http://localhost:8000

# In development, use the CRA dev-server proxy to avoid CORS.
# When true, client requests are same-origin and proxied by src/setupProxy.js.
REACT_APP_USE_DEV_PROXY=true
REACT_APP_DEV_PROXY_TARGET=http://localhost:8000

# Dev auth bypass (never enable in production)
REACT_APP_AUTH_BYPASS_ENABLED=true

# Option A: paste pre-issued JWTs
REACT_APP_AUTH_ACCESS_TOKEN=
REACT_APP_AUTH_REFRESH_TOKEN=

# Option B: auto-login + auto-refresh
# Paths are relative to REACT_APP_API_BASE_URL
REACT_APP_AUTH_LOGIN_PATH=/auth/login
REACT_APP_AUTH_REFRESH_PATH=/auth/refresh
REACT_APP_AUTH_EMAIL=
REACT_APP_AUTH_USERNAME=
REACT_APP_AUTH_PASSWORD=
