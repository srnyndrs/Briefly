# Application
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
FEED_EXCHANGE=feed.content

# Sentry DSN
SENTRY_DSN=

# Crawler behaviour
CRAWL_INTERVAL_SECONDS=300
FETCH_TIMEOUT_SECONDS=30
SOURCE_VALIDATION_TIMEOUT_SECONDS=10
SOURCE_VALIDATION_MAX_BYTES=1048576
MAX_RETRIES=5
VERIFIED_CRAWL_INTERVAL_SECONDS=300
UNVERIFIED_CRAWL_INTERVAL_SECONDS=1800
