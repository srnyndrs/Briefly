# Application
APP_HOST=0.0.0.0
APP_PORT=8005
LOG_LEVEL=INFO
ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/briefly

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RESULT_EXCHANGE=enrichment.events

# Sentry DSN
SENTRY_DSN=

# Optional key for explicit Gemini evaluation only
GEMINI_API_KEY=

# Host development: choose and pull a model. Compose supplies its own model setting.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
